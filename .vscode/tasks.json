{
    "tasks": [
        {
            "type": "shell",
            "label": "mkdir build",
            "command": "mkdir -p ${workspaceFolder}/build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++-14",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++23",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger.",
            "dependsOn": "mkdir build"
        },
        {
            "type": "shell",
            "label": "rolling-sum: regression test",
            "command": "case \"${fileBasename}\" in rolling-sum*|tick.hpp|tick-generator.hpp) /usr/bin/g++-14 -fdiagnostics-color=always -std=c++23 -O2 -Wall -Wextra \"${workspaceFolder}/src/feed-handler/rolling-sum-regression-test.cpp\" -o \"${workspaceFolder}/build/rolling-sum-regression-test\" && \"${workspaceFolder}/build/rolling-sum-regression-test\" ;; esac",
            "options": {
                "cwd": "${workspaceFolder}/src/feed-handler"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Builds and runs the RollingSum regression test when the active file is part of rolling-sum.",
            "dependsOn": "mkdir build"
        },
        {
            "type": "shell",
            "label": "build active file (skip headers)",
            "command": "case \"${fileExtname}\" in .h|.hpp) echo \"Header file: nothing to compile on its own.\" ;; *) /usr/bin/g++-14 -fdiagnostics-color=always -std=c++23 -Wall -Wextra -g \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\" ;; esac",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Same as 'C/C++: g++ build active file', but does nothing when a header is focused.",
            "dependsOn": "mkdir build"
        },
        {
            "label": "build + regression",
            "dependsOn": [
                "build active file (skip headers)",
                "rolling-sum: regression test"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++-14 build active file",
            "command": "/usr/bin/g++-14",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger.",
            "dependsOn": "mkdir build"
        }
    ],
    "version": "2.0.0"
}
